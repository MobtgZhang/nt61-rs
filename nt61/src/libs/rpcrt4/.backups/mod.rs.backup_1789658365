/// Free an RPC string allocated by the runtime
#[no_mangle]
pub unsafe extern "C" fn RpcStringFreeW(string: *mut *mut u16) -> RPC_STATUS {
    if string.is_null() || (*string).is_null() {
        return RPC_S_OK;
    }

    crate::mm::pool::free(*string as *mut u8);
    *string = core::ptr::null_mut();

    RPC_S_OK
}

/// Free an RPC string (ASCII version)
#[no_mangle]
pub unsafe extern "C" fn RpcStringFreeA(string: *mut *mut u8) -> RPC_STATUS {
    if string.is_null() || (*string).is_null() {
        return RPC_S_OK;
    }

    crate::mm::pool::free(*string);
    *string = core::ptr::null_mut();

