//
// Protocol sequence vector management
//

/// Free a protocol sequence vector
#[no_mangle]
pub unsafe extern "C" fn RpcProtseqVectorFreeW(
    protseq_vector: *mut *mut types::RPC_PROTSEQ_VECTOR,
) -> RPC_STATUS {
    if protseq_vector.is_null() || (*protseq_vector).is_null() {
        return RPC_S_OK;
    }

    let vector = *protseq_vector;
    let count = (*vector).count as usize;

    // Free each protocol sequence string
    for i in 0..count {
        let protseq_ptr = (*vector).protseq.as_ptr().add(i);
        if !(*protseq_ptr).is_null() {
            crate::mm::pool::free(*protseq_ptr as *mut u8);
        }
    }

    // Free the vector itself
    crate::mm::pool::free(vector as *mut u8);
    *protseq_vector = core::ptr::null_mut();

    RPC_S_OK
}

/// Inquire supported protocol sequences
#[no_mangle]
pub unsafe extern "C" fn RpcNetworkInqProtseqsW(
    protseq_vector: *mut *mut types::RPC_PROTSEQ_VECTOR,
) -> RPC_STATUS {
    if protseq_vector.is_null() {
        return RPC_S_INVALID_BINDING;
    }

    // Allocate vector for 3 protocol sequences
    let vector_size = core::mem::size_of::<types::RPC_PROTSEQ_VECTOR>()
        + 2 * core::mem::size_of::<*mut u16>();

    let vector = crate::mm::pool::allocate(
        crate::mm::pool::PoolType::NonPaged,
        vector_size,
    ) as *mut types::RPC_PROTSEQ_VECTOR;

    if vector.is_null() {
        return RPC_S_OUT_OF_MEMORY;
    }

    (*vector).count = 3;

    // Allocate and copy protocol sequence names
    let protseqs = [
        types::PROTSEQ_NCALRPC,
        types::PROTSEQ_NCACN_NP,
        types::PROTSEQ_NCACN_IP_TCP,
    ];

    for (i, protseq) in protseqs.iter().enumerate() {
        let len = protseq.len();
        let buffer = crate::mm::pool::allocate(
            crate::mm::pool::PoolType::NonPaged,
            len * 2,
        ) as *mut u16;

        if buffer.is_null() {
            // Clean up previously allocated strings
            for j in 0..i {
                let ptr = *(*vector).protseq.as_ptr().add(j);
                if !ptr.is_null() {
                    crate::mm::pool::free(ptr as *mut u8);
                }
            }
            crate::mm::pool::free(vector as *mut u8);
            return RPC_S_OUT_OF_MEMORY;
        }

        // Copy string
        for j in 0..len {
            *buffer.add(j) = protseq[j];
        }

        *(*vector).protseq.as_mut_ptr().add(i) = buffer;
    }

    *protseq_vector = vector;
    RPC_S_OK
}

/// Free a binding vector
#[no_mangle]
pub unsafe extern "C" fn RpcBindingVectorFree(
    binding_vector: *mut *mut types::RPC_BINDING_VECTOR,
) -> RPC_STATUS {
    if binding_vector.is_null() || (*binding_vector).is_null() {
        return RPC_S_OK;
    }

    let vector = *binding_vector;
    let count = (*vector).count as usize;

    // Free each binding handle
    for i in 0..count {
        let binding_ptr = (*vector).binding_h.as_mut_ptr().add(i);
        if !(*binding_ptr).is_null() {
            let _ = binding::RpcBindingFree(binding_ptr);
        }
    }

    // Free the vector itself
    crate::mm::pool::free(vector as *mut u8);
    *binding_vector = core::ptr::null_mut();

    RPC_S_OK
}

