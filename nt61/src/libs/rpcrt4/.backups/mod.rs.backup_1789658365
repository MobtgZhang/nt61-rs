static mut LAST_EXCEPTION_CODE: u32 = 0;

/// Get the current RPC exception code
#[no_mangle]
pub unsafe extern "C" fn RpcExceptionCode() -> u32 {
    LAST_EXCEPTION_CODE
}

/// Set the RPC exception code (internal)
#[no_mangle]
pub unsafe extern "C" fn RpcSetExceptionCode(code: u32) {
    LAST_EXCEPTION_CODE = code;
}

/// Check if RPC terminated abnormally
#[no_mangle]
pub unsafe extern "C" fn RpcAbnormalTermination() -> i32 {
    if LAST_EXCEPTION_CODE != 0 {
        1
    } else {
        0
    }
}

