/// Inquire the object type
#[no_mangle]
pub unsafe extern "C" fn RpcObjectInqType(
    obj_uuid: *mut UUID,
    type_uuid: *mut *mut UUID,
) -> RPC_STATUS {
    if obj_uuid.is_null() || type_uuid.is_null() {
        return RPC_S_INVALID_BINDING;
    }

    // Return nil type UUID
    let uuid = crate::mm::pool::allocate(
        crate::mm::pool::PoolType::NonPaged,
        core::mem::size_of::<UUID>(),
    ) as *mut UUID;

    if uuid.is_null() {
        return RPC_S_OUT_OF_MEMORY;
    }

    *uuid = UUID::default();
    *type_uuid = uuid;

    RPC_S_OK
}

