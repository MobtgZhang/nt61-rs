}

/// Allocate memory from RPC runtime pool
#[no_mangle]
pub unsafe extern "C" fn RpcSmAllocate(size: usize, status: *mut RPC_STATUS) -> *mut core::ffi::c_void {
    let ptr = crate::mm::pool::allocate(
        crate::mm::pool::PoolType::NonPaged,
        size,
    ) as *mut core::ffi::c_void;

    if !status.is_null() {
        if ptr.is_null() {
            *status = RPC_S_OUT_OF_MEMORY;
        } else {
            *status = RPC_S_OK;
        }
    }

    ptr
}

/// Free memory allocated by RpcSmAllocate
#[no_mangle]
pub unsafe extern "C" fn RpcSmFree(ptr: *mut core::ffi::c_void) -> RPC_STATUS {
    if ptr.is_null() {
        return RPC_S_OK;
    }

    crate::mm::pool::free(ptr as *mut u8);
    RPC_S_OK
}

