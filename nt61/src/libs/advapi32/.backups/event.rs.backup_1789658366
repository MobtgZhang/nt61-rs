/// GetNumberOfEventLogRecords — Get the number of records in the event log
#[no_mangle]
pub unsafe extern "C" fn GetNumberOfEventLogRecords(
    hEventLog: HANDLE_EVENTLOG,
    NumberOfRecords: *mut DWORD,
) -> LONG {
    if NumberOfRecords.is_null() {
        return 0; // FALSE
    }

    // Validate handle
    if get_event_handle(hEventLog).is_none() {
        return 0; // FALSE
    }

    // Count active entries
    let mut count = 0;
    for entry in EVENT_LOG.iter() {
        if entry.in_use {
            count += 1;
        }
    }

    *NumberOfRecords = count;
    1 // TRUE
}

/// GetOldestEventLogRecord — Get the oldest record number
#[no_mangle]
pub unsafe extern "C" fn GetOldestEventLogRecord(
    hEventLog: HANDLE_EVENTLOG,
    OldestRecord: *mut DWORD,
) -> LONG {
    if OldestRecord.is_null() {
        return 0; // FALSE
    }

    // Validate handle
    if get_event_handle(hEventLog).is_none() {
        return 0; // FALSE
    }

    // For simple implementation, oldest is always record 0
    *OldestRecord = 0;
    1 // TRUE
}

