/// Initialize the C Runtime Library
///
/// Sets up internal state, initializes file handles, and prepares
/// the CRT for use by applications.
pub fn init() {
    // Initialize standard streams
    unsafe {
        stdio::stdin = &mut stdio::STDIN_FILE as *mut FILE;
        stdio::stdout = &mut stdio::STDOUT_FILE as *mut FILE;
        stdio::stderr = &mut stdio::STDERR_FILE as *mut FILE;
    }

