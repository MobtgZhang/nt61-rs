#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_crt_init() {
        init();
        assert!(is_initialized());
    }

    #[test]
    fn test_version() {
        let ver = version();
        assert!(ver.contains("MSVCRT"));
        assert!(ver.contains("NT6.1"));
    }

    #[test]
    fn test_memory_allocation() {
        unsafe {
            let ptr = malloc(100);
            assert!(!ptr.is_null());
            free(ptr);
        }
    }

    #[test]
    fn test_string_operations() {
        unsafe {
            let src = b"Hello\0".as_ptr() as *const c_char;
            let mut dst = [0i8; 10];
            strcpy(dst.as_mut_ptr(), src);
            assert_eq!(strcmp(dst.as_ptr(), src), 0);
            assert_eq!(strlen(src), 5);
        }
    }

    #[test]
    fn test_conversion() {
        unsafe {
            let s = b"123\0".as_ptr() as *const c_char;
            assert_eq!(atoi(s), 123);

            let mut buf = [0i8; 20];
            itoa(456, buf.as_mut_ptr(), 10);
            assert_eq!(atoi(buf.as_ptr()), 456);
        }
    }

    #[test]
    fn test_character_classification() {
        assert_eq!(isdigit(b'5' as c_int), 1);
        assert_eq!(isalpha(b'a' as c_int), 1);
        assert_eq!(isspace(b' ' as c_int), 1);
        assert_eq!(tolower(b'A' as c_int), b'a' as c_int);
        assert_eq!(toupper(b'z' as c_int), b'Z' as c_int);
    }
}
