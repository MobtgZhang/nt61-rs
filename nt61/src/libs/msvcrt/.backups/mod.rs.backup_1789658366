/// Security cookie for stack protection (GS)
#[no_mangle]
pub static mut __security_cookie: usize = 0xBB40E64E;

/// Security cookie complement
#[no_mangle]
pub static mut __security_cookie_complement: usize = !0xBB40E64E;

/// Initialize security cookie
#[no_mangle]
pub unsafe extern "C" fn __security_init_cookie() {
    // Would generate random cookie in real implementation
    __security_cookie = 0xBB40E64E;
    __security_cookie_complement = !__security_cookie;
}

/// Check security cookie (stack buffer overrun detection)
#[no_mangle]
pub unsafe extern "C" fn __security_check_cookie(cookie: usize) {
    if cookie != __security_cookie {
        // Stack corruption detected
        abort();
    }
}

/// Security cookie failure handler
#[no_mangle]
pub unsafe extern "C" fn __report_gsfailure() -> ! {
    // Report stack buffer overrun
    abort()
}

/// CRT initialization for C++ (stub)
#[no_mangle]
pub unsafe extern "C" fn _initterm(start: *const *const c_void, end: *const *const c_void) {
    let mut ptr = start;
    while ptr < end {
        if !(*ptr).is_null() {
            let func: extern "C" fn() = core::mem::transmute(*ptr);
            func();
        }
        ptr = ptr.add(1);
    }
}

/// CRT initialization for C++ with return value (stub)
#[no_mangle]
pub unsafe extern "C" fn _initterm_e(
    start: *const *const c_void,
    end: *const *const c_void,
) -> c_int {
    let mut ptr = start;
    while ptr < end {
        if !(*ptr).is_null() {
            let func: extern "C" fn() -> c_int = core::mem::transmute(*ptr);
            let result = func();
            if result != 0 {
                return result;
            }
        }
        ptr = ptr.add(1);
    }
    0
}

