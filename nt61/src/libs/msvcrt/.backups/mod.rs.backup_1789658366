/// Control floating-point error handling
#[no_mangle]
pub unsafe extern "C" fn _controlfp(new: c_uint, mask: c_uint) -> c_uint {
    // Return default FP control word
    0x027f
}

/// Control floating-point error handling (secure version)
#[no_mangle]
pub unsafe extern "C" fn _controlfp_s(
    current: *mut c_uint,
    new: c_uint,
    mask: c_uint,
) -> errno_t {
    if !current.is_null() {
        *current = 0x027f;
    }
    0
}

