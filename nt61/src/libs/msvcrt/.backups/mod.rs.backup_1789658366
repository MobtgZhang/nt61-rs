/// Get the CRT version string
pub fn version() -> &'static str {
    "MSVCRT 10.0 (NT6.1.7601) - Rust Implementation"
}

/// Check if the CRT is initialized
pub fn is_initialized() -> bool {
    unsafe { !stdio::stdin.is_null() && !stdio::stdout.is_null() && !stdio::stderr.is_null() }
}

