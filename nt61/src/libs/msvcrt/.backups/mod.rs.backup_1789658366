/// CRT Statistics (for debugging and monitoring)
#[derive(Debug, Clone, Copy)]
pub struct CrtStats {
    pub allocations: usize,
    pub deallocations: usize,
    pub bytes_allocated: usize,
    pub files_opened: usize,
    pub files_closed: usize,
}

impl CrtStats {
    pub const fn new() -> Self {
        CrtStats {
            allocations: 0,
            deallocations: 0,
            bytes_allocated: 0,
            files_opened: 0,
            files_closed: 0,
        }
    }
}

static mut CRT_STATS: CrtStats = CrtStats::new();

/// Get current CRT statistics
pub fn get_stats() -> CrtStats {
    unsafe { CRT_STATS }
}

/// Reset CRT statistics
pub fn reset_stats() {
    unsafe {
        CRT_STATS = CrtStats::new();
    }
}

